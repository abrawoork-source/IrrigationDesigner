<!-- File: src/IrrigationApp/Views/ReportsView.xaml -->
<UserControl x:Class="IrrigationApp.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="📄 " FontSize="22"/>
                <TextBlock Text="{Binding L_Title}" Style="{StaticResource PageTitle}" Margin="0"/>
            </StackPanel>

            <!-- Status -->
            <Border Background="#F0FDF4" CornerRadius="6" Padding="12" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅ " FontSize="14"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#15803D" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Zone Summary -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding L_ZoneSummary}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Total flow, precipitation rate, and irrigation runtime per zone."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding L_ExportExcel}"
                            Command="{Binding ZoneSummaryExcelCommand}"
                            Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="{Binding L_ExportPdf}"
                            Command="{Binding ZoneSummaryPdfCommand}"
                            Style="{StaticResource DangerButton}"/>
                </Grid>
            </Border>

            <!-- Hydraulics Report -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding L_Hydraulics}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Pipe segments: velocity, head loss, pressure drop."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding L_ExportPdf}"
                            Command="{Binding HydraulicsPdfCommand}"
                            Style="{StaticResource DangerButton}"/>
                </Grid>
            </Border>

            <!-- BOM -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding L_BOM}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Bill of materials: nozzles, pipes by diameter, valves."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding L_ExportExcel}"
                            Command="{Binding BomExcelCommand}"
                            Style="{StaticResource SuccessButton}"/>
                </Grid>
            </Border>

            <!-- Project Export / Import JSON -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Project Backup (JSON)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Versioned JSON export for backup, sharing, or archiving. Format v1."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding L_ExportJson}"
                            Command="{Binding ExportProjectJsonCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="{Binding L_ImportJson}"
                            Command="{Binding ImportProjectJsonCommand}"
                            Style="{StaticResource GhostButton}"/>
                </Grid>
            </Border>

            <!-- Note -->
            <Border Background="#FFF7ED" CornerRadius="6" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ " FontSize="14"/>
                    <TextBlock FontSize="12" Foreground="#92400E" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Note:</Run>
                        <Run Text=" Run 'Calculate' and 'Design Check' before exporting to ensure data is current."/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
