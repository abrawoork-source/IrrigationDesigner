<!-- File: src/IrrigationApp/Views/MainWindow.xaml -->
<Window x:Class="IrrigationApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IrrigationApp.Views"
        xmlns:vm="clr-namespace:IrrigationApp.ViewModels"
        Title="{Binding L_AppTitle}"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}"
        FlowDirection="{Binding FlowDir}">

    <Window.Resources>
        <!-- Page DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WaterSourceViewModel}">
            <views:WaterSourceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZonesViewModel}">
            <views:ZonesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NozzleDatabaseViewModel}">
            <views:NozzleDatabaseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DripDatabaseViewModel}">
            <views:DripDatabaseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HeadsViewModel}">
            <views:HeadsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PipeNetworkViewModel}">
            <views:PipeNetworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalculationsViewModel}">
            <views:CalculationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EvaluationViewModel}">
            <views:EvaluationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top bar -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Top Bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💧" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding L_AppTitle}"
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Project Selector + Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding L_SelectProject}"
                               Foreground="#93C5FD" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="Name"
                              Width="200" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="{Binding L_NewProject}"
                            Command="{Binding NewProjectCommand}"
                            Style="{StaticResource GhostButton}"
                            Foreground="White" BorderBrush="White"
                            Margin="12,0,0,0" Padding="10,5"/>
                    <Button Content="{Binding L_LoadSample}"
                            Command="{Binding LoadSampleCommand}"
                            Style="{StaticResource GhostButton}"
                            Foreground="White" BorderBrush="White"
                            Margin="8,0,0,0" Padding="10,5"/>
                </StackPanel>

                <!-- Language Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding L_Language}"
                               Foreground="#93C5FD" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Command="{Binding ToggleLanguageCommand}"
                            Style="{StaticResource GhostButton}"
                            Foreground="White" BorderBrush="White" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentLanguage, StringFormat='{}Switch Language'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Area ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ──────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <Button Content="{Binding L_Dashboard}"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Style="{StaticResource NavButton}"/>
                        <Separator Background="#334155" Margin="12,4"/>
                        <TextBlock Text="PROJECT" Foreground="#475569" FontSize="10"
                                   FontWeight="Bold" Margin="22,6,0,4"
                                   HorizontalAlignment="Left"/>
                        <Button Content="{Binding L_WaterSource}"
                                Command="{Binding NavigateCommand}" CommandParameter="WaterSource"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="{Binding L_Zones}"
                                Command="{Binding NavigateCommand}" CommandParameter="Zones"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="{Binding L_Heads}"
                                Command="{Binding NavigateCommand}" CommandParameter="Heads"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="{Binding L_PipeNetwork}"
                                Command="{Binding NavigateCommand}" CommandParameter="PipeNetwork"
                                Style="{StaticResource NavButton}"/>
                        <Separator Background="#334155" Margin="12,4"/>
                        <TextBlock Text="DATABASE" Foreground="#475569" FontSize="10"
                                   FontWeight="Bold" Margin="22,6,0,4"
                                   HorizontalAlignment="Left"/>
                        <Button Content="{Binding L_NozzleDatabase}"
                                Command="{Binding NavigateCommand}" CommandParameter="NozzleDatabase"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="{Binding L_DripDatabase}"
                                Command="{Binding NavigateCommand}" CommandParameter="DripDatabase"
                                Style="{StaticResource NavButton}"/>
                        <Separator Background="#334155" Margin="12,4"/>
                        <TextBlock Text="ANALYSIS" Foreground="#475569" FontSize="10"
                                   FontWeight="Bold" Margin="22,6,0,4"
                                   HorizontalAlignment="Left"/>
                        <Button Content="{Binding L_Calculations}"
                                Command="{Binding NavigateCommand}" CommandParameter="Calculations"
                                Style="{StaticResource NavButton}"/>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Evaluation"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙ " Foreground="#FBBF24"/>
                                <TextBlock Text="{Binding L_Evaluation}"
                                           Foreground="{StaticResource SidebarTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{Binding L_Reports}"
                                Command="{Binding NavigateCommand}" CommandParameter="Reports"
                                Style="{StaticResource NavButton}"/>
                        <!-- Version -->
                        <TextBlock Text="v1.0.0 – Irrigation Design Pro"
                                   Foreground="#475569" FontSize="9"
                                   Margin="16,20,16,12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Page Content ─────────────────────────────────────────── -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>

        <!-- ── Status Bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedProject.Name, StringFormat='Project: {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
