<!-- File: src/IrrigationApp/Views/WaterSourceView.xaml -->
<UserControl x:Class="IrrigationApp.Views.WaterSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="700">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="💧 " FontSize="22"/>
                <TextBlock Text="{Binding L_Title}" Style="{StaticResource PageTitle}" Margin="0"/>
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Water Source Configuration"
                               Style="{StaticResource SectionTitle}"/>

                    <!-- Static Pressure -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,12,8">
                        <TextBlock Text="{Binding L_StaticPressure}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StaticPressure_bar, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="{Binding Pressure_kpa, StringFormat='= {0:F1} kPa'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Available Flow -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,8,0,8">
                        <TextBlock Text="{Binding L_Flow}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AvailableFlow_Lmin, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="{Binding Flow_m3h, StringFormat='= {0:F3} m³/h'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Elevation -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,12,8">
                        <TextBlock Text="{Binding L_Elevation}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Elevation_m, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,8">
                        <TextBlock Text="{Binding L_Notes}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Info panel -->
                    <Border Grid.Row="4" Grid.ColumnSpan="2"
                            Background="#EFF6FF" CornerRadius="6" Padding="12" Margin="0,8,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ " FontSize="14"/>
                            <TextBlock FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap">
                                <Run Text="Available pressure at source. Add head losses from valves and pipes to determine working pressure at heads."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Save Button -->
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Button Content="{Binding L_Save}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
