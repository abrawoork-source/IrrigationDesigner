<!-- File: src/IrrigationApp/Views/PipeNetworkView.xaml -->
<UserControl x:Class="IrrigationApp.Views.PipeNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🔩 " FontSize="22"/>
            <TextBlock Text="{Binding L_Title}" Style="{StaticResource PageTitle}" Margin="0"/>
        </StackPanel>

        <!-- Nodes Panel -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Pipe Nodes" Style="{StaticResource SectionTitle}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{Binding L_AddNode}"    Command="{Binding AddNodeCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="10,6"/>
                    <Button Content="{Binding L_DeleteNode}" Command="{Binding DeleteNodeCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="10,6"/>
                    <Button Content="{Binding L_SaveNode}"   Command="{Binding SaveNodeCommand}"
                            Style="{StaticResource SuccessButton}" Padding="10,6"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="False" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"   Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                        <DataGridComboBoxColumn Header="{Binding DataContext.L_NodeType,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItemBinding="{Binding Type}"
                                                ItemsSource="{Binding DataContext.NodeTypes,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="120"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_Elevation,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding Elevation_m, StringFormat='{}{0:F2}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Segments Panel -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Pipe Segments" Style="{StaticResource SectionTitle}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{Binding L_AddSegment}"    Command="{Binding AddSegmentCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="10,6"/>
                    <Button Content="{Binding L_DeleteSegment}" Command="{Binding DeleteSegmentCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="10,6"/>
                    <Button Content="{Binding L_SaveSegment}"   Command="{Binding SaveSegmentCommand}"
                            Style="{StaticResource SuccessButton}" Padding="10,6"/>
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Segments}"
                          SelectedItem="{Binding SelectedSegment}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"    Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_FromNode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding FromNodeId}" Width="80"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_ToNode,   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding ToNodeId}"   Width="80"/>
                        <DataGridComboBoxColumn Header="{Binding DataContext.L_Material, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItemBinding="{Binding Material}"
                                                ItemsSource="{Binding DataContext.Materials,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="70"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_Diameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding Diameter_mm, StringFormat='{}{0:F0}'}" Width="90"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_Length, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding Length_m,    StringFormat='{}{0:F1}'}" Width="80"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_FittingsLength, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding FittingsEquivLength_m, StringFormat='{}{0:F1}'}" Width="120"/>
                        <DataGridTextColumn Header="{Binding DataContext.L_Notes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
