<!-- File: src/IrrigationApp/Views/DashboardView.xaml -->
<UserControl x:Class="IrrigationApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">

            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="📊 " FontSize="22"/>
                <TextBlock Text="{Binding L_Title}" Style="{StaticResource PageTitle}" Margin="0"/>
            </StackPanel>

            <!-- Project Info Banner -->
            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Padding="20,16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ProjectName}" FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Current Project" FontSize="12" Foreground="#93C5FD" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding L_DesignCheck}"
                            Command="{Binding RunDesignCheckCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Background="White" Foreground="{StaticResource PrimaryBrush}"
                            FontSize="14" Padding="20,10"/>
                </Grid>
            </Border>

            <!-- Summary Cards Row -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Zones -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🗺" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ZoneCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_Zones}" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Center" Margin="0"/>
                    </StackPanel>
                </Border>
                <!-- Heads -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💦" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding HeadCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_Heads}" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Center" Margin="0"/>
                    </StackPanel>
                </Border>
                <!-- Segments -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔩" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SegmentCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_Segments}" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Center" Margin="0"/>
                    </StackPanel>
                </Border>
                <!-- Flow -->
                <Border Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📈" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalFlow_Lmin, StringFormat='{}{0:F1}'}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Flow (L/min)" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Center" Margin="0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Design Status Panel -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rating Badge -->
                    <Border Grid.Column="0" Background="{Binding RatingColor}" CornerRadius="8"
                            Padding="24,16" Margin="0,0,24,0" MinWidth="180">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RatingEmoji}" FontSize="36"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RatingText}" FontSize="14"
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding L_Status}" FontSize="11"
                                       Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Issue Counts -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Design Check Summary" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="3" Margin="0,8,0,16">
                            <Border Background="#FEF2F2" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ErrorCount}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="Errors" FontSize="11" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFBEB" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Text="Warnings" FontSize="11" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F0F9FF" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding InfoCount}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Info" FontSize="11" Foreground="#0284C7"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Issues list -->
                        <ItemsControl ItemsSource="{Binding Issues}" MaxHeight="200">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding SeverityColor}" BorderThickness="0,0,0,1"
                                            Padding="4,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SeverityEmoji}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
