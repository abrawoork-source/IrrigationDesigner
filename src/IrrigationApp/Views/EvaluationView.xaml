<!-- File: src/IrrigationApp/Views/EvaluationView.xaml -->
<UserControl x:Class="IrrigationApp.Views.EvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Run Button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="⚙ " FontSize="22"/>
                <TextBlock Text="{Binding L_Title}" Style="{StaticResource PageTitle}" Margin="0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding L_DesignCheck}"
                    Command="{Binding RunCheckCommand}"
                    Style="{StaticResource PrimaryButton}" FontSize="15" Padding="24,12"/>
        </Grid>

        <!-- Rating Dashboard -->
        <Border Grid.Row="1" CornerRadius="12" Padding="24" Margin="0,0,0,20"
                Background="{Binding RatingColor}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="{Binding RatingText}" FontSize="26" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="{Binding L_Rating}" FontSize="13" Foreground="#E2E8F0"/>
                </StackPanel>

                <!-- Error count -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20,12" Margin="8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ErrorCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_Errors}" FontSize="11"
                                   Foreground="#DC2626" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Warning count -->
                <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="20,12" Margin="8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WarningCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_Warnings}" FontSize="11"
                                   Foreground="#D97706" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Info count -->
                <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="20,12" Margin="8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding InfoCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_Info}" FontSize="11"
                                   Foreground="#0284C7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Thresholds Config -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Expander Header="{Binding L_Thresholds}" IsExpanded="False">
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{Binding L_MaxLatVel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Threshold_MaxLateralVelocity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{Binding L_MaxMainVel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Threshold_MaxMainlineVelocity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{Binding L_MinHeadPres}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Threshold_MinHeadPressure, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{Binding L_MaxHeadPres}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Threshold_MaxHeadPressure, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{Binding L_MaxPRMis}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Threshold_MaxPRMismatch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{Binding L_MaxPresVar}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Threshold_MaxPressureVariation, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>
            </Expander>
        </Border>

        <!-- Issues Table -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Issues}"
                  Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{Binding DataContext.L_Severity, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SeverityEmoji}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="{Binding Code}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Code"     Binding="{Binding Code}"         Width="120"/>
                <DataGridTextColumn Header="{Binding DataContext.L_Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Binding="{Binding Message}" Width="*"/>
                <DataGridTextColumn Header="{Binding DataContext.L_SuggestedFix, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Binding="{Binding SuggestedFix}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SeverityEmoji}" Value="❌">
                            <Setter Property="Background" Value="#FEF2F2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SeverityEmoji}" Value="⚠">
                            <Setter Property="Background" Value="#FFFBEB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
